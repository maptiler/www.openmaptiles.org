#!/usr/bin/env bash
#
# Probes a deployed site and reports what each legacy URL from script/redirects.tsv
# actually does. Run it before the cutover to record the baseline, and again after, so
# the two lists can be diffed.
#
#   script/verify-live                              # https://openmaptiles.org
#   script/verify-live https://labs.maptiler.com/www.openmaptiles.org
#   script/verify-live > after.txt                  # then: diff before.txt after.txt
#
# The pre-cutover baseline is committed at script/legacy-baseline-2026-08-03.txt. Never
# redirect this script's output over it: it records what production answered BEFORE the
# cutover, and once that has happened no run of this script can reproduce it.
#
# It reports rather than asserts. A legacy URL can legitimately answer 200 before the
# cutover (it was a real page) and 200 after (it is now a meta-refresh stub), so
# status codes alone prove nothing — what matters is that every row resolves to the
# expected destination by some route. The `->` column is where the request finally
# lands after following redirects, including the meta-refresh ones this build emits,
# which curl cannot follow. Those show as "200 (stub)" plus the target read out of the
# HTML.
set -uo pipefail

BASE="${1:-https://openmaptiles.org}"
BASE="${BASE%/}"
MANIFEST="script/redirects.tsv"
test -f "$MANIFEST" || { echo "run from the repo root: $MANIFEST not found"; exit 2; }

printf '%s\n' "probing $BASE"
printf '%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
printf '\n%-30s %-6s %s\n' "URL" "CODE" "RESOLVES TO"
printf '%-30s %-6s %s\n' "------------------------------" "------" "-----------"

while IFS=$'\t' read -r url target scope; do
  case "$url" in ''|'#'*) continue ;; esac

  body=$(curl -sS -L --max-time 20 -w '\n%{http_code}\t%{url_effective}' "$BASE$url" 2>/dev/null) || {
    printf '%-30s %-6s %s\n' "$url" "ERR" "request failed"
    continue
  }
  meta=$(printf '%s' "$body" | tail -1)
  code=$(printf '%s' "$meta" | cut -f1)
  final=$(printf '%s' "$meta" | cut -f2)

  # A meta-refresh stub answers 200 at its own URL; the real destination is in the
  # markup, which curl -L will not follow.
  stub=$(printf '%s' "$body" | grep -oE 'location="[^"]*"' | head -1 | sed 's/location="//; s/"$//')

  if [ -n "$stub" ]; then
    printf '%-30s %-6s %s\n' "$url" "$code" "$stub  (meta-refresh stub)"
  else
    printf '%-30s %-6s %s\n' "$url" "$code" "${final#"$BASE"}"
  fi
done < "$MANIFEST"
